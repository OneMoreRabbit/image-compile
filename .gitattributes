* text=auto eol=lf

# Python files always LF — pytest collection and tooling are line-ending sensitive.
*.py        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.j2        text eol=lf
*.env       text eol=lf
*.toml      text eol=lf
*.md        text eol=lf
.gitignore  text eol=lf
# --- Atlas --- scripts and conf must stay LF everywhere: CRLF breaks the
# shebang in Linux containers and puts \r into sourced values, which fails
# the write guard open. Targeted rules only — repo-wide eol policy is yours.
*.sh text eol=lf
.atlas.conf text eol=lf
