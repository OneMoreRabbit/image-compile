# Stub secrets injected into the probe container's configs/main/secrets.env.
# All values are placeholders that let OpenClaw boot far enough to reach /healthz
# without actually authenticating to any external service. Never put real
# credentials here.
DISCORD_BOT_TOKEN=stub-discord-token-not-real
STUB_API_KEY=stub-model-key-not-real
OPENCLAW_GATEWAY_TOKEN=stub-gateway-token-not-real
